MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kaamkaaz
JWT_SECRET=your_long_random_secret_here
FIREBASE_SERVICE_ACCOUNT=path/to/serviceAccount.json
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
PORT=5005
NODE_ENV=development
FRONTEND_URL=*
GEMINI_API_KEY=your_gemini_api_key_here

# ── Admin Multi-Layer Security (required for /api/admin routes) ───────────────
# Separate JWT secret used only for admin tokens (keep different from JWT_SECRET)
ADMIN_JWT_SECRET=your_separate_admin_secret_here_min_32_chars
# Admin pending token expiry (Layer 1 — after password, before OTP)
ADMIN_JWT_PENDING_EXPIRE=15m
# Full admin session expiry (Layer 2 — after OTP passes)
ADMIN_JWT_EXPIRE=30m

# ── Email/SMTP for admin alerts (Layer 2 OTP + Layer 3 anomaly emails) ────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-admin-email@gmail.com
SMTP_PASS=your_gmail_app_password
ADMIN_ALERT_EMAIL=admin@kaamkaaz.app

# ── Server public URL (used for IP confirmation email links — Layer 3) ────────
SERVER_URL=https://your-backend-domain.com

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 1.2 — JWT Hardening (Access + Refresh Tokens)
# ═════════════════════════════════════════════════════════════════════════════
# Separate secret for access tokens (different from JWT_SECRET)
ACCESS_TOKEN_SECRET=<generate: openssl rand -hex 32>
# Separate secret for refresh tokens (must differ from ACCESS_TOKEN_SECRET)
REFRESH_TOKEN_SECRET=<generate: openssl rand -hex 32>
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 5+6 — Field Encryption (AES-256-GCM for Aadhaar)
# ═════════════════════════════════════════════════════════════════════════════
# Exactly 64 hex chars = 32 bytes. Generate: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=<generate: openssl rand -hex 32>

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 5.4 — CORS (comma-separated allowed origins for production)
# Leave empty in development (all origins allowed)
# ═════════════════════════════════════════════════════════════════════════════
ALLOWED_ORIGINS=https://kaamkaaz.app,https://app.kaamkaaz.app

